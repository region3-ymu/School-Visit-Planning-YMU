generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth (NextAuth / Auth.js v5) ─────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String    @unique
  emailVerified   DateTime?
  image           String?
  hashedPassword  String?
  role            Role      @default(MENTOR)
  /// Administers the app — calendar sync, accounts, correcting somebody else's
  /// record — independently of the job title in `role`.
  ///
  /// Separate because the two are genuinely different facts and YMU has a
  /// person who is both: Pedro Diaz is the CPO, and the app should say CPO,
  /// but he also administers it. Folding that into the role would either
  /// mislabel him ADMIN on every report or leave the CPO unable to fix a visit
  /// logged against the wrong school. There can be any number of them.
  isAppAdmin      Boolean   @default(false)
  /// Reads and plans afterschool alongside the school day, instead of having it
  /// filtered out by programmeScopeFor().
  ///
  /// Afterschool belongs to the AFTER_SCHOOL_MANAGER across every region, and
  /// that stays true. This is the named exception: North runs a programme at
  /// Norland its Regional Manager is accountable for, and the filter was
  /// hiding all 52 of its sessions from him. A flag rather than a branch on
  /// the role or the region because YMU was explicit that it is one person for
  /// now and expected to move — so changing it should be an update, not a
  /// migration. Same shape, and the same reasoning, as isAppAdmin above.
  ///
  /// Mirrored by profiles.sees_afterschool in YMU-A (its migration 0113),
  /// which is the same decision about the same person in the other app.
  seesAfterschool Boolean   @default(false)
  regionId        String?
  // Saved "start from home" location for route/mileage calculations —
  // only used when explicitly selected, never assumed automatically.
  homeAddress     String?
  homeLat         Float?
  homeLng         Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  region        Region?   @relation("UserRegion", fields: [regionId], references: [id])
  // The region this user manages (only populated for REGIONAL_MANAGER role)
  managedRegion Region?   @relation("RegionManager")
  accounts      Account[]
  sessions      Session[]
  visits        Visit[]

  @@index([regionId])
}

// ─── Organization ─────────────────────────────────────────────────────────────

model Region {
  id                String   @id @default(cuid())
  name              String   @unique
  code              String   @unique
  regionalManagerId String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  manager User?    @relation("RegionManager", fields: [regionalManagerId], references: [id])
  users   User[]   @relation("UserRegion")
  schools School[]
}

// ─── Schools ──────────────────────────────────────────────────────────────────

model School {
  id                         String       @id @default(cuid())
  // schools.id in the YMU-A Supabase roster, for rows that came from there.
  // The re-sync key: without it a second import has to reconcile by name, and
  // fuzzy name matching on this roster silently merges different schools
  // ("Homestead Senior High" vs "Homestead Middle School").
  externalId                 String?      @unique
  name                       String
  zipCode                    String       @default("")
  address                    String?
  lat                        Float?
  lng                        Float?
  // Where lat/lng came from: 'ymu-a' | 'ors' | 'google' | 'manual'. Rows
  // sourced from YMU-A arrive already geocoded and must not be re-geocoded.
  geocodeSource              String?
  availability               String       @default("[]")
  /// Merged duplicate / dropped from the roster (import scripts). Not the
  /// same thing as `status`: the nightly YMU-A import rewrites this one.
  active                     Boolean      @default(true)
  /// #64: ACTIVE, ON_HOLD (ours, but no classes yet — not planned, not
  /// counted, no "Never visited") or INACTIVE (we no longer work there, or it
  /// closed — hidden except in history). Set only from the app; no import
  /// touches it.
  status                     SchoolStatus @default(ACTIVE)
  statusReason               String?
  statusChangedAt            DateTime?
  statusChangedById          String?
  /// When the school last came back to ACTIVE. Cadence counts from here, so a
  /// school resumed today is not instantly "overdue" or "never visited".
  activeSince                DateTime?
  /// "No classes for weeks — put on hold?" dismissed until this date.
  holdSuggestionSnoozedUntil DateTime?
  /// True for the YMU office. Kept out of school lists, counts, the planner
  /// and the roster importers, but reachable for mileage like any other stop.
  isOffice                   Boolean      @default(false)
  regionId                   String?
  // Unique: two schools pinned to the same calendar would duplicate every
  // ClassSession that calendar produces.
  googleCalendarId           String?      @unique
  // Google Calendar Events.list sync token for incremental sync — null means
  // the next sync does a full pull (first sync, or after a 410 Gone reset).
  calendarSyncToken          String?
  calendarLastSyncedAt       DateTime?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  region        Region?               @relation(fields: [regionId], references: [id])
  classSessions ClassSession[]
  teachers      Teacher[]
  scheduleNotes ProgramScheduleNote[]
  visits        Visit[]
  visitRules    VisitRule[]

  @@index([regionId])
  @@index([isOffice])
  @@index([status])
}

enum SchoolStatus {
  ACTIVE
  ON_HOLD
  INACTIVE
}

model Teacher {
  id             String             @id @default(cuid())
  /// The teacher's YMU-A profile id. Present for anyone imported from there,
  /// null for rows the calendar sync invented.
  externalId     String?            @unique
  name           String
  subjects       String?
  email          String?
  schoolId       String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  classSessions  ClassSession[]
  /// Legacy back-relation of Visit.observedTeacherId — see VisitObservation.
  observedVisits Visit[]
  observations   VisitObservation[]
  school         School?            @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

model Subject {
  id             String             @id @default(cuid())
  name           String             @unique
  description    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  classSessions  ClassSession[]
  /// Legacy back-relation of Visit.observedSubjectId — see VisitObservation.
  observedVisits Visit[]
  observations   VisitObservation[]
}

model ClassSession {
  id               String   @id @default(cuid())
  schoolId         String
  teacherId        String?
  subjectId        String
  startDateTime    DateTime
  endDateTime      DateTime
  googleCalendarId String
  googleEventId    String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  school           School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject          Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher          Teacher? @relation(fields: [teacherId], references: [id])

  @@unique([googleCalendarId, googleEventId])
  @@index([schoolId])
  @@index([teacherId])
  @@index([startDateTime, endDateTime])
}

model VisitRule {
  id            String        @id @default(cuid())
  schoolId      String
  frequencyType FrequencyType
  priority      VisitPriority @default(NORMAL)
  notes         String?
  reason        String?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model Visit {
  id                   String      @id @default(cuid())
  schoolId             String
  plannedStartDateTime DateTime
  plannedEndDateTime   DateTime
  status               VisitStatus
  reason               String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  school               School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // ─── Visit confirmation details (captured via the Confirm Visit modal) ──────
  visitedById                   String?
  visitedBy                     User?               @relation(fields: [visitedById], references: [id])
  mode                          VisitMode           @default(IN_PERSON)
  /// Whose fuel. Van miles are recorded but never reimbursable — YMU already
  /// paid for them.
  vehicle                       VehicleType         @default(PERSONAL)
  // Driven distance for this visit's leg, computed server-side from the
  // chosen origin (home/GPS/custom address) to the school's coordinates.
  milesDriven                   Decimal?            @db.Decimal(6, 2)
  originLabel                   String?
  /// Coordinates of that origin. Without them a day's mileage can be read but
  /// never recomputed, so a stop remembered out of order could not be fixed.
  originLat                     Float?
  originLng                     Float?
  // Closing leg of the day, back to where the RM started. Held on the
  // day's last visit so a day can only ever carry one return.
  returnMilesDriven             Decimal?            @db.Decimal(6, 2)
  returnLabel                   String?
  /// Share of milesDriven that is commute — set when the day started from home.
  /// The IRS rule excludes it from reimbursement. Payable miles for a visit are
  /// milesDriven + returnMilesDriven - commuteMiles - returnCommuteMiles.
  commuteMiles                  Decimal?            @db.Decimal(6, 2)
  /// Share of returnMilesDriven that is commute — the leg that ends at home.
  /// Separate from commuteMiles so each has a single writer.
  returnCommuteMiles            Decimal?            @db.Decimal(6, 2)
  outcome                       VisitOutcome?
  outcomeNotes                  String?
  /// LEGACY — superseded by VisitObservation (20261016000000_visit_observations)
  /// and no longer written or read. Kept, not dropped, so nothing recorded
  /// before a visit could hold several observations is lost; the migration
  /// copied it into a VisitObservation with the visit's own id.
  ///
  /// The teacher the ratings below are about. Known from the class slot the
  /// visit was booked against; null for anything logged before it was captured.
  observedTeacherId             String?
  observedTeacher               Teacher?            @relation(fields: [observedTeacherId], references: [id], onDelete: SetNull)
  /// LEGACY — superseded by VisitObservation.subjectId; no longer written or read.
  ///
  /// Which programme was in the room — "Beginning Band", "Modern Band". Same
  /// source as observedTeacherId: the class slot the visit was booked against.
  ///
  /// Subject and not ClassSession, though the slot is what is actually known.
  /// ClassSession rows are disposable — the calendar sync deletes cancelled
  /// events and scripts/prune-past-class-sessions.ts drops last year wholesale,
  /// both on the stated assumption that nothing references them. A visit that
  /// outlives its slot must still say which programme it watched, and Subject
  /// is the stable catalogue: unique by name, only ever created.
  observedSubjectId             String?
  observedSubject               Subject?            @relation(fields: [observedSubjectId], references: [id], onDelete: SetNull)
  visitedWith                   VisitedWithOption[]
  principalNotes                String?
  hasInstrumentRequest          Boolean             @default(false)
  instrumentRequestDetails      String?
  // Future integration flag — no actual API push is implemented yet.
  instrumentRequestSyncedToYMPA Boolean             @default(false)
  // Distance (meters) between device GPS and the school at confirm time.
  geofenceDistanceM             Float?
  // True when the visit was confirmed outside the geofence radius (or with
  // no GPS available) via the explicit "confirm anyway" override.
  geofenceOverridden            Boolean             @default(false)

  // ─── Teacher observation (shown when visitedWith includes YMU_TEACHER) ──────
  /// One per class watched. A visit used to hold exactly one observation, and
  /// Carol City MS and North Dade run two classes at the same time in the same
  /// building — the RM watched both and could rate only one (Eric Levy,
  /// 2026-10-15). Each class gets its own ratings and notes, and each teacher
  /// sees only their own in YMU-A.
  observations               VisitObservation[]
  /// LEGACY — the single observation a visit used to hold. Superseded by
  /// VisitObservation and no longer written or read; kept so nothing is lost.
  obsPlanningPrep            ObservationRating?
  /// LEGACY — see obsPlanningPrep.
  obsCultureManagement       ObservationRating?
  /// LEGACY — see obsPlanningPrep.
  obsInstructionMusicianship ObservationRating?
  /// LEGACY — see obsPlanningPrep.
  obsEngagementEvidence      ObservationRating?
  /// LEGACY — see obsPlanningPrep.
  obsProfessionalismGrowth   ObservationRating?
  /// LEGACY — see obsPlanningPrep. Now VisitObservation.notes.
  obsNotes                   String?
  // Why the visit has no observations. These stay on the visit: "Did you see a
  // class?" is answered once for the whole visit, not per class.
  //
  // Why the rubric is blank. Without this, an unrated visit is
  // indistinguishable from an RM who simply skipped the paperwork.
  obsSkipReason              ObservationSkipReason?
  obsSkipNotes               String?

  @@index([schoolId])
  @@index([status])
  @@index([visitedById])
  @@index([vehicle])
  @@index([observedTeacherId])
  @@index([observedSubjectId])
}

/// One class an RM watched on a visit, and how it went.
///
/// Its own row because a visit can watch more than one class: two run at the
/// same time in the same building at Carol City MS and North Dade, and the RM
/// stands in both. Each gets its own five ratings and its own notes, and goes
/// to YMU-A as that teacher's evaluation only — the other teacher never sees it.
///
/// The id is what YMU-A keys the evaluation by (svp_observation_id), so an edit
/// keeps the ids of the observations it keeps rather than deleting and
/// recreating them. The ones migrated from the single-observation columns
/// reuse their visit's id, which is what YMU-A already had them under.
model VisitObservation {
  id                         String             @id @default(cuid())
  visitId                    String
  visit                      Visit              @relation(fields: [visitId], references: [id], onDelete: Cascade)
  /// Whose class it was. SetNull, not Cascade: removing a teacher must not
  /// delete the record of a lesson somebody watched.
  teacherId                  String?
  teacher                    Teacher?           @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  /// Which programme. Subject rather than ClassSession for the reason given on
  /// the legacy Visit.observedSubjectId: class sessions are disposable.
  subjectId                  String?
  subject                    Subject?           @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  // Each domain is independently skippable ("didn't see it this visit").
  obsPlanningPrep            ObservationRating?
  obsCultureManagement       ObservationRating?
  obsInstructionMusicianship ObservationRating?
  obsEngagementEvidence      ObservationRating?
  obsProfessionalismGrowth   ObservationRating?
  // One notes field covering all 5 domains, not one per domain.
  notes                      String?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  @@index([visitId])
  @@index([teacherId])
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  /// Administers the app itself: calendar sync, accounts, correcting bad data.
  ADMIN
  /// Owns one region's schools and the cadence they are visited on.
  REGIONAL_MANAGER
  /// Owns afterschool programmes across EVERY region, so carries no regionId.
  /// Not a REGIONAL_MANAGER with a null region: null there means "not assigned
  /// yet", and the two must not be confused by a query. Mirrors YMU-A's
  /// afterschool_manager, which exists for the same reason.
  AFTER_SCHOOL_MANAGER
  /// Oversight. See everything, plan nothing — the three of them are the same
  /// set of permissions with three names, and the only reason there are three
  /// is the org chart. Kept apart anyway so a report can say who looked.
  CPO
  OPERATIONS_MANAGER
  ACADEMIC_MANAGER
  MENTOR
  INTERVENTIONIST
}

enum FrequencyType {
  WEEKLY
  BIWEEKLY
  EVERY_3_WEEKS
  MONTHLY
}

enum VisitPriority {
  LOW
  NORMAL
  HIGH
}

enum VisitStatus {
  PLANNED
  DONE
  CANCELLED
  SKIPPED
}

// How the visit went — distinct from VisitStatus (which tracks
// scheduling state, not the outcome of a completed visit).
enum VisitOutcome {
  GOOD
  REGULAR
}

// How the visit actually happened. A remote visit still records who was met
// and what was discussed, but there is no drive to measure and no class in the
// room to observe.
enum VisitMode {
  IN_PERSON
  ONLINE
  PHONE
}

/// Which vehicle a visit was driven in. Decides whether its miles are owed back.
enum VehicleType {
  PERSONAL
  YMU_VAN
  /// Rode along in a colleague's or someone else's personal car — an in-person
  /// visit, but not the RM's own fuel, so its miles are recorded and never owed
  /// back to them either, same as YMU_VAN but tracked apart since it isn't
  /// YMU's vehicle.
  OTHER_PERSON_CAR
}

enum VisitedWithOption {
  PRINCIPAL
  MAIN_OFFICE
  INSCHOOL_MUSIC_TEACHER
  YMU_TEACHER
}

enum ObservationRating {
  NEEDS_SUPPORT
  DEVELOPING
  MEETS
  EXCEEDS
}

/// Why a YMU-teacher visit carries no observation ratings.
enum ObservationSkipReason {
  /// The class ran and the teacher was seen; this visit was for something else.
  DID_NOT_STAY
  NO_CLASS_TODAY
  CLASS_CANCELLED
  TEACHER_ABSENT
  SCHEDULE_CONFLICT
  OTHER
}

// ─── Route optimization cache ───────────────────────────────────────────────────

model TravelMatrixCache {
  id          String   @id @default(cuid())
  originLat   Float
  originLng   Float
  destLat     Float
  destLng     Float
  durationSec Float
  distanceM   Float
  createdAt   DateTime @default(now())

  @@unique([originLat, originLng, destLat, destLng])
}

// ─── Google Calendar sync ───────────────────────────────────────────────────

// Review queue: a Google Calendar was pulled during sync but didn't match
// any active School by name. Cleared (resolvedAt set) once a later sync
// run does find a match.
model CalendarSyncIssue {
  id              String    @id @default(cuid())
  calendarId      String
  calendarSummary String?
  reason          String // "NO_MATCHING_SCHOOL" | "AMBIGUOUS_MATCH"
  // JSON [{ name, score }] — the top scoring schools the matcher rejected.
  // Without them an AMBIGUOUS_MATCH row tells a reviewer nothing actionable.
  candidates      String?
  detectedAt      DateTime  @default(now())
  resolvedAt      DateTime?

  @@index([resolvedAt])
}

// ─── Reporting ───────────────────────────────────────────────────────────────

// 9-week grading-period quarters. Dates are placeholders until the real
// MDCPS school-year calendar is entered — swapping them is a data change,
// not a code change.
model Quarter {
  id         String   @id @default(cuid())
  schoolYear String // e.g. "2026-27"
  label      String // e.g. "Q1"
  startDate  DateTime
  endDate    DateTime

  @@unique([schoolYear, label])
}

/// A line from the master programmes spreadsheet, shown as reference beside a
/// school's timetable. Read-only: nothing plans, prices or schedules from it.
model ProgramScheduleNote {
  id             String   @id @default(cuid())
  schoolId       String
  /// Matched to a Subject by name — the sheet is hand-written and its wording
  /// drifts from the calendar's.
  subjectName    String
  /// "A days", "B days", "Odd dates of the month" — as the sheet words it.
  dayPattern     String?
  period         String?
  timesText      String?
  teacherName    String?
  scheduleStatus String?
  sourceRow      Int?
  importedAt     DateTime @default(now())
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

/// Where a background sync left off, by name (#53). One row per feed —
/// today just "ymua-class-feed": the cursor into YMU-A's class feed, the end
/// of the window it last covered (so a week newly entering the window is
/// fetched in full), and when it last ran (the 5-minute throttle).
model SyncState {
  key        String    @id
  cursor     String?
  windowEnd  DateTime?
  lastRunAt  DateTime?
  lastResult String?
  updatedAt  DateTime  @updatedAt
}
