# Copy to .env and fill in. Nothing here has a usable default.

# ─── Database ────────────────────────────────────────────────────────────────
# Neon Postgres. Prisma reads this directly.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ─── Auth (NextAuth v5) ──────────────────────────────────────────────────────
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Google sign-in, restricted to @ymu.org accounts.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Seeded by `npm run db:seed`.
ADMIN_EMAIL="pedro@ymu.org"
ADMIN_PASSWORD=""

# ─── Google Calendar sync ────────────────────────────────────────────────────
# Base64 of the service-account JSON. The YMU calendars are ACL-shared with
# this account and subscribed to its calendarList, so it sees all of them and
# there is no refresh token to expire. Same value as YMU-A uses.
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=""
# Shared secret for POST /api/cron/sync-calendars.
CRON_SECRET=""

# ─── Roster import from YMU-A ────────────────────────────────────────────────
# Source of truth for schools: name, address, lat/lng, region, calendar id.
# Copy both from the YMU-A checkout's .env.local
# (NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY).
YMUA_SUPABASE_URL=""
YMUA_SUPABASE_SERVICE_ROLE_KEY=""

# ─── Routing & geocoding ─────────────────────────────────────────────────────
# Required: distance matrix, directions, and Pelias geocoding.
OPENROUTE_SERVICE_API_KEY=""
# Optional: geocoding fallback when ORS finds no street-level match.
GOOGLE_MAPS_API_KEY=""

# ─── Planner ─────────────────────────────────────────────────────────────────
PLANNER_WORK_START="08:00"
PLANNER_WORK_END="16:00"

# ─── AI chat (optional) ──────────────────────────────────────────────────────
OPENROUTER_API_KEY=""
